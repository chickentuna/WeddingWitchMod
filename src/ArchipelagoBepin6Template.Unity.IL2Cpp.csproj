<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>WeddingWitchArchipelago</AssemblyName>
        <Description>Archipelago multiworld randomizer for Wedding Witch</Description>
        <Version>1.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <!-- you may need this for getting the multiclient dll to output for .net 6 and netstandard 2.0 -->
        <!--        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>-->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <RootNamespace>WeddingWitchArchipelago</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>/home/jpn/.steam/debian-installation/steamapps/common/Wedding Witch/BepInEx/plugins/$(AssemblyName)</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\$(AssemblyName)</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
    </PropertyGroup>

    <Target Name="ZipMod" AfterTargets="PostBuildEvent" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <ZipDirectory SourceDirectory="bin\Release\$(AssemblyName)"
                      DestinationFile="bin\Release\$(AssemblyName)-$(Version).zip"
                      Overwrite="true"/>
    </Target>

    <ItemGroup>
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.6.0" />
        <PackageReference Include="Archipelago.MultiClient.Net.Analyzers" Version="1.3.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.61f1" IncludeAssets="compile" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

    <!-- Game types (UpgradeItem, UpgradeWitchCanvas, GlobalStat, WitchCandy.Save.Save, ...) come from
         the IL2CPP interop Assembly-CSharp.dll, GENERATED ON FIRST BepInEx LAUNCH under the game's
         BepInEx/interop/. The build cannot resolve those types until you've run the game once.
         If UnityEngine types from this interop clash with the UnityEngine.Modules NuGet above, drop that
         PackageReference and reference the interop UnityEngine.*.dll here instead. -->
    <PropertyGroup>
        <GameDir>/home/jpn/.steam/debian-installation/steamapps/common/Wedding Witch</GameDir>
        <InteropDir>$(GameDir)/BepInEx/interop</InteropDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(InteropDir)/Assembly-CSharp.dll')">
        <Reference Include="$(InteropDir)/Assembly-CSharp.dll">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
